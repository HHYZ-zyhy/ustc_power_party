# 科大战力党玩家数据存储服务 —— 环境变量样例
#
# 安装脚本会把它复制为 /etc/warrior-store.env（属主 root:root，权限 0640）。
# 该文件可能含 WARRIOR_STORE_PEPPER，不要提交到版本库、不要设为全局可读。
# 修改任何一项后执行：sudo systemctl restart warrior-store
#
# 布尔项可写 1/0，也可写 true/false、yes/no、on/off。
# 配置优先级：命令行参数 > 环境变量 > 内置默认值。
# 下方每项等号右侧即内置默认值（PEPPER 为空）。

# 监听地址。默认 127.0.0.1（仅本机可访问）。
# 改为 0.0.0.0 会监听所有网卡，必须自行用防火墙限制来源，详见 README §5。
WARRIOR_STORE_HOST=127.0.0.1

# 监听端口。默认 8080。小于 1024 的端口需要额外权限，不推荐。
WARRIOR_STORE_PORT=8080

# SQLite 数据库文件路径。建议绝对路径；相对路径相对于 WorkingDirectory=/opt/warrior-store。
# 目录必须属于 warrior-store 用户且可写（服务已用 StateDirectory 创建 /var/lib/warrior-store）。
WARRIOR_STORE_DB=/var/lib/warrior-store/store.sqlite3

# token 哈希用的 pepper，默认留空。
# 一旦设置为非空值就【不可再更改】：更改后所有已发出的 token 立即失效，玩家只能重新注册。
# 建议在第一次注册前就设定，并另行安全备份本行内容（丢失同样会让所有 token 失效）。
WARRIOR_STORE_PEPPER=

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL。默认 INFO。
WARRIOR_STORE_LOG_LEVEL=INFO

# 访问日志是否记录客户端 IP：1 = 记录（默认），0 = 不记录（隐私优先）。
WARRIOR_STORE_LOG_IP=1

# 是否输出访问日志（journald 中单行 JSON）：1 = 输出（默认），0 = 关闭。
WARRIOR_STORE_ACCESS_LOG=1

# 注册限流：每个 IP 每小时最多注册次数。默认 20；0 = 关闭注册限流。
WARRIOR_STORE_REGISTER_PER_HOUR=20

# 上报限流：每个玩家每小时最多上报次数。默认 600；0 = 关闭。
WARRIOR_STORE_RESULTS_PER_HOUR=600

# 是否信任反向代理传来的 X-Forwarded-For：1 = 信任，0 = 不信任（默认）。
# 只有前面确实有可信反向代理（如本机 nginx）时才设为 1，否则客户端可伪造 IP 绕过限流。
WARRIOR_STORE_TRUST_PROXY=0
